NODE_ENV=production
HOST=0.0.0.0
PORT=3100
PUBLIC_BASE_URL=https://node.example.org
WORKSPACE_BASE_URL=https://crm.example.org
CORE_API_TOKEN=
MCP_API_TOKEN=
WORKSPACE_SERVICE_TOKEN=
CONNECTOR_VAULT_KEY=
OAUTH_STATE_SECRET=
DATA_DIR=./runtime
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://node.example.org/oauth/google/callback
GOOGLE_SYNC_QUERY=newer_than:2d
GOOGLE_SYNC_MAX_RESULTS=25
TELEGRAM_BOT_TOKEN=
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=60
MCP_ALLOW_WRITES=false
MCP_ALLOW_SENSITIVE_WRITES=false
HTTP_TIMEOUT_MS=20000

# ---- Aharon Search sub-application (/search/) ----
# Keep SEARCH_ENABLED=0 while the original Hub entrypoint is in use.
SEARCH_ENABLED=0
SEARCH_ADMIN_TOKEN=
SEARCH_PUBLIC_BASE_URL=https://node.example.org
SEARCH_DATA_DIR=./runtime/search

SEARCH_OSINT_ENABLED=1
SEARCH_SERPAPI_KEY=
SEARCH_TIMEOUT_MS=45000
SEARCH_MAX_RESULTS_PER_SOURCE=6
SEARCH_MAX_QUERIES_PER_SOURCE=1
SEARCH_MAX_EXPANSION_ROUNDS=1

SEARCH_REGISTRY_DB_ENABLED=0
SEARCH_REGISTRY_DB_HOST=127.0.0.1
SEARCH_REGISTRY_DB_PORT=3306
SEARCH_REGISTRY_DB_NAME=
SEARCH_REGISTRY_DB_USER=
SEARCH_REGISTRY_DB_PASSWORD=
SEARCH_REGISTRY_DB_POOL_SIZE=4
SEARCH_REGISTRY_DB_CONNECT_TIMEOUT_MS=10000

SEARCH_WHATSAPP_ENABLED=0
SEARCH_WHATSAPP_TIMEOUT_MS=180000

SEARCH_AI_REPORT_ENABLED=1
SEARCH_AI_REPORT_API_KEY=
SEARCH_AI_REPORT_API_URL=https://openrouter.ai/api/v1/chat/completions
SEARCH_AI_REPORT_MODEL=openrouter/free
SEARCH_AI_REPORT_FALLBACK_MODEL=openrouter/free
SEARCH_AI_REPORT_TIMEOUT_MS=45000

# Direct / optional OSINT adapters used by the search module
GITHUB_DIRECT_ENABLED=1
GITHUB_PUBLIC_TOKEN=
REDDIT_PUBLIC_ENABLED=1
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AharonSearch/6.0 profile-correlation
YOUTUBE_DIRECT_ENABLED=1
YOUTUBE_API_KEY=
X_DIRECT_ENABLED=1
X_BEARER_TOKEN=
INSTAGRAM_DIRECT_ENABLED=1
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v26.0
TIKTOK_WORKER_ENABLED=0
TIKTOK_WORKER_URL=
SOCIAL_ANALYZER_ENABLED=0
PHONEINFOGA_ENABLED=0
PHONEINFOGA_BASE_URL=

# Opt-in registration on the existing Aharon Node Hub (same process and port).
SEARCH_ENABLED=1
# Generate an independent random token of at least 32 characters. Never commit its real value.
SEARCH_ADMIN_TOKEN=
SEARCH_PUBLIC_BASE_URL=https://YOUR-NODE-HUB-HOST

# Existing Aharon Search: SerpAPI is for Web / forums / Lens only.
SEARCH_SERPAPI_KEY=
SEARCH_MAX_RESULTS_PER_SOURCE=6
SEARCH_MAX_QUERIES_PER_SOURCE=1
SEARCH_MAX_EXPANSION_ROUNDS=1
SEARCH_TIMEOUT_MS=45000

# AI report is optional. The hub can reuse OPENROUTER_API_KEY when already set.
SEARCH_AI_REPORT_ENABLED=0
SEARCH_AI_REPORT_API_KEY=
SEARCH_AI_REPORT_API_URL=https://openrouter.ai/api/v1/chat/completions
SEARCH_AI_REPORT_MODEL=openrouter/free
SEARCH_AI_REPORT_FALLBACK_MODEL=openrouter/free

SEARCH_OSINT_ENABLED=1
# Optional sources. Missing tokens must not be interpreted as "person has no profile".
GITHUB_DIRECT_ENABLED=1
REDDIT_PUBLIC_ENABLED=1
YOUTUBE_DIRECT_ENABLED=0
YOUTUBE_API_KEY=
X_DIRECT_ENABLED=0
X_BEARER_TOKEN=
INSTAGRAM_DIRECT_ENABLED=0
META_ACCESS_TOKEN=
META_IG_USER_ID=
TIKTOK_WORKER_ENABLED=0
TIKTOK_WORKER_URL=
SOCIAL_ANALYZER_ENABLED=0
PHONEINFOGA_ENABLED=0

# Independent storage. Use a persistent directory outside public_html.
SEARCH_DATA_DIR=./runtime/search
SEARCH_WHATSAPP_ENABLED=0
SEARCH_WHATSAPP_TIMEOUT_MS=180000

# Registry is OFF until explicitly configured by an authorized administrator.
SEARCH_REGISTRY_DB_ENABLED=0
SEARCH_REGISTRY_DB_HOST=127.0.0.1
SEARCH_REGISTRY_DB_PORT=3306
SEARCH_REGISTRY_DB_NAME=
SEARCH_REGISTRY_DB_USER=
SEARCH_REGISTRY_DB_PASSWORD=
SEARCH_REGISTRY_DB_POOL_SIZE=4
SEARCH_REGISTRY_DB_CONNECT_TIMEOUT_MS=10000
